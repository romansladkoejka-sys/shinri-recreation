local CharacterMenu

local Characters = {
    {
        id = "ibuki",
        name = "Ибуки Миода",
        description = "Ultimate Musician"
    },

    {
        id = "nagito",
        name = "Нагито Комаэда",
        description = "Ultimate Lucky Student"
    },

    {
        id = "komaru",
        name = "Комару Наэги",
        description = "Ordinary Student"
    },

    {
        id = "nagisa",
        name = "Нагиса Шингецу",
        description = "Lil' Ultimate Social Studies"
    }
}


local function OpenCharacterMenu()

    if IsValid(CharacterMenu) then
        CharacterMenu:Remove()
    end

    CharacterMenu = vgui.Create("DFrame")

    CharacterMenu:SetSize(600, 450)
    CharacterMenu:Center()

    CharacterMenu:SetTitle("")
    CharacterMenu:SetDraggable(false)
    CharacterMenu:ShowCloseButton(false)

    CharacterMenu:MakePopup()

    CharacterMenu.Paint = function(self, w, h)

        draw.RoundedBox(
            8,
            0,
            0,
            w,
            h,
            Color(25, 12, 18, 245)
        )

        draw.SimpleText(
            "ВЫБЕРИТЕ ПЕРСОНАЖА",
            "Trebuchet24",
            w / 2,
            30,
            Color(255, 255, 255),
            TEXT_ALIGN_CENTER
        )

        draw.SimpleText(
            "Shinri Recreation",
            "Trebuchet18",
            w / 2,
            60,
            Color(180, 120, 150),
            TEXT_ALIGN_CENTER
        )

    end


    local y = 100

    for _, character in ipairs(Characters) do

        local button =
            vgui.Create(
                "DButton",
                CharacterMenu
            )

        button:SetPos(
            50,
            y
        )

        button:SetSize(
            500,
            65
        )

        button:SetText("")

        button.Paint =
            function(self, w, h)

            local bg

            if self:IsHovered() then
                bg = Color(
                    100,
                    35,
                    55,
                    245
                )
            else
                bg = Color(
                    60,
                    25,
                    35,
                    230
                )
            end

            draw.RoundedBox(
                5,
                0,
                0,
                w,
                h,
                bg
            )

            draw.SimpleText(
                character.name,
                "Trebuchet24",
                15,
                10,
                Color(
                    255,
                    255,
                    255
                )
            )

            draw.SimpleText(
                character.description,
                "Trebuchet18",
                15,
                38,
                Color(
                    190,
                    190,
                    190
                )
            )

        end


        button.DoClick =
            function()

            net.Start(
                "ShinriCharacter_Select"
            )

            net.WriteString(
                character.id
            )

            net.SendToServer()

            CharacterMenu:Remove()

            gui.EnableScreenClicker(
                false
            )

        end

        y = y + 75

    end

end


net.Receive(
    "ShinriCharacter_Open",
    function()

        OpenCharacterMenu()

    end
)
